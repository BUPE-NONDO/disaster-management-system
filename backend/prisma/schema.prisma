// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(RESPONDER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents Incident[]
  responses Response[]

  @@map("users")
}

model Incident {
  id          String         @id @default(cuid())
  type        IncidentType
  title       String
  description String?
  severity    Severity
  status      IncidentStatus @default(REPORTED)
  location    String
  coordinates Json? // {lat: number, lng: number}
  reportedBy  String
  reportedAt  DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  reporter  User       @relation(fields: [reportedBy], references: [id])
  responses Response[]
  resources ResourceAllocation[]

  @@map("incidents")
}

model Response {
  id         String   @id @default(cuid())
  incidentId String
  responderId String
  message    String
  timestamp  DateTime @default(now())

  incident  Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  responder User     @relation(fields: [responderId], references: [id])

  @@map("responses")
}

model Resource {
  id          String     @id @default(cuid())
  name        String
  type        ResourceType
  description String?
  available   Int        @default(0)
  total       Int
  location    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  allocations ResourceAllocation[]

  @@map("resources")
}

model ResourceAllocation {
  id         String   @id @default(cuid())
  incidentId String
  resourceId String
  quantity   Int
  allocatedAt DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id])

  @@map("resource_allocations")
}

enum UserRole {
  ADMIN
  COORDINATOR
  RESPONDER
  REPORTER
}

enum IncidentType {
  FIRE
  FLOOD
  EARTHQUAKE
  HURRICANE
  TORNADO
  LANDSLIDE
  EXPLOSION
  CHEMICAL_SPILL
  MEDICAL_EMERGENCY
  TRAFFIC_ACCIDENT
  POWER_OUTAGE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  ACKNOWLEDGED
  RESPONDING
  RESOLVED
  CLOSED
}

enum ResourceType {
  VEHICLE
  PERSONNEL
  EQUIPMENT
  MEDICAL_SUPPLY
  FOOD_WATER
  SHELTER
  COMMUNICATION
  OTHER
}